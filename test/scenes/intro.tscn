[sub_resource type="GDScript" id="GDScript_1tkkt"]
script/source = "extends Node2D

func _ready():
	# Play the fade-in animation
	$CanvasLayer/AnimationPlayer.play(\"Fade in\")
	await get_tree().create_timer(6).timeout  # Wait for fade-in to finish

	# Play the fade-out animation
	$CanvasLayer/AnimationPlayer.play(\"Fade out\")
	await get_tree().create_timer(6).timeout  # Wait for fade-out to finish

	# Hide the CanvasLayer after the animation
	$CanvasLayer.visible = false
"

